    {
      "name": "Crear mochila",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"codigo\": \"MOCH001\",\r\n  \"modelo\": \"Mochila Urbana\",\r\n  \"color\": \"Negro\",\r\n  \"categoria\": \"URBANA\",\r\n  \"precio\": 89.90,\r\n  \"cantidad\": 10,\r\n  \"almacen\": \"PRINCIPAL\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/productos",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "productos"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// ===== BEFORE REQUEST =====",
              "const ahora = new Date().toISOString();",
              "pm.collectionVariables.set(\"fechaActual\", ahora);",
              "pm.collectionVariables.set(\"metodoActual\", pm.request.method);",
              "console.log(\"Petición:\", pm.request.name);",
              "console.log(\"Método:\", pm.request.method);",
              "console.log(\"URL:\", pm.request.url.toString());",
              "console.log(\"Fecha:\", ahora);",
              "",
              "// Generar datos dinámicos para una nueva mochila",
              "const numero = Math.floor(Math.random() * 9000) + 1000;",
              "pm.collectionVariables.set(\"codigoAleatorio\", \"MOCH\" + numero);",
              "pm.collectionVariables.set(\"operacionActual\", \"CREAR_MOCHILA\");",
              "console.log(\"Código dinámico generado:\", pm.collectionVariables.get(\"codigoAleatorio\"));",
              "",
              "// Verificar que la petición tenga un body antes de enviarla",
              "pm.test(\"Pre-request: existe body para crear\", function () {",
              "    pm.expect(pm.request.body).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 o 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"La respuesta es JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"La mochila creada contiene datos válidos\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\");",
              "    pm.expect(jsonData).to.have.property(\"codigo\");",
              "    pm.expect(jsonData).to.have.property(\"modelo\");",
              "    pm.expect(jsonData).to.have.property(\"precio\");",
              "    pm.expect(jsonData).to.have.property(\"cantidad\");",
              "});",
              "",
              "pm.test(\"El código enviado es correcto\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.codigo).to.eql(\"MOCH001\");",
              "});",
              "",
              "// Si la API devuelve un id, lo guardamos para poder reutilizarlo.",
              "const jsonData = pm.response.json();",
              "if (jsonData.id !== undefined && jsonData.id !== null) {",
              "    pm.collectionVariables.set(\"productoId\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ]
